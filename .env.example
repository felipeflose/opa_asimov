# Configuração do obsidian_graph_app
# Copie este arquivo para .env e preencha com suas credenciais reais.

# ── chaves de API de terceiros ──────────────────────────────
# Chave de API para o Groq LLM (ex: llama-3.1-8b-instant)
GROQ_API_KEY=gsk_suachaveaqui...

# Token do Bot do Telegram (gerado via @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ...

# Token de API do Napkin (caso utilize serviços da Napkin)
NAPKIN_API_TOKEN=sk-suachavenapkin...

# ── Segurança do Web App ──────────────────────────────────
# Chave de API secreta para proteger endpoints destrutivos do app Flask (ex: /api/run-update)
FLOSE_API_KEY=sua_chave_de_api_secreta_aqui

# ── Configurações do Ollama ───────────────────────────────
# Modelo padrão de texto usado pelo Ollama (padrão: gemma4:latest)
OLLAMA_MODEL=gemma4:latest

# URL do servidor Ollama local (padrão: http://localhost:11434/api/generate)
OLLAMA_URL=http://localhost:11434/api/generate

# Modelo padrão usado para Embeddings (padrão: nomic-embed-text:latest)
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# URL do servidor Ollama para geração de embeddings (padrão: http://localhost:11434/api/embeddings)
OLLAMA_EMBED_URL=http://localhost:11434/api/embeddings

# ── Configurações de Caminhos (Paths) ─────────────────────
# Caminho absoluto ou relativo para a pasta do Vault do Obsidian (padrão: ./vault_temp)
FLOSE_VAULT_PATH=./vault_temp

# ── Configurações do Bot do Telegram ─────────────────────
# Lista de IDs de chat autorizados a falar com o bot (separados por vírgula)
FLOSE_ALLOWED_CHAT_IDS=123456789,987654321

# Limite de tempo de mensagens do Bot (segundos)
FLOSE_RATE_LIMIT_SECONDS=2

# Limite de conexões de chats simultâneos
FLOSE_MAX_CHATS=10

# ── Configurações do Servidor Flask ───────────────────────
# Habilitar modo debug do Flask ("true" ou "false")
FLASK_DEBUG=false

# Porta em que o servidor Flask irá rodar (padrão: 8091)
PORT=8091

# Chave anterior para suportar rotação de API keys
FLOSE_API_KEY_PREVIOUS=chave_antiga_anterior_aqui

# ── Configurações de Logging & Observabilidade ───────────
# Nível de logging geral do sistema (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Formato dos logs gerados (TEXT ou JSON)
LOG_FORMAT=TEXT

# ── Configurações do Auditor de Linhagem (Edge Agent) ──────
# Timeout máximo do Ollama em segundos (padrão: 120)
OLLAMA_TIMEOUT=120

# Limite máximo de pares analisados por ciclo na busca de cross-links
FLOSE_MAX_CROSS_CHECK_PAIRS=10

# Tempo de sleep entre a auditoria de cada nó (segundos)
FLOSE_SLEEP_AUDIT_NODE=3

# Tempo de sleep de cooldown entre etapas (segundos)
FLOSE_SLEEP_COOLDOWN=0.5
